{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "klon",
            "camelcase": "Klon",
            "title": "Klon",
            "scope": "source.klon",
            "file-types": ["klon", "glas.pack", "klar.build", "klar.lint", "klar.format"],
            "injection-regex": "^klon$",
            "class-name": "TreeSitterKlon",
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm"
        }
    ],
    "metadata": {
        "version": "0.1.0",
        "license": "MIT",
        "description": "Klon grammar for tree-sitter",
        "authors": [
            { "name": "ProCode Software", "url": "https://github.com/ProCode-Software" }
        ],
        "links": {
            "repository": "https://github.com/tree-sitter/tree-sitter-klon",
            "funding": ""
        }
    },
    "bindings": {
        "c": true,
        "go": false,
        "java": false,
        "node": true,
        "python": false,
        "rust": true,
        "swift": false,
        "zig": false
    }
}
